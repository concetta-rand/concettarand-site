---
import Base from '../layouts/Base.astro';
import {books} from '../data/content.js';
---
<Base title="Reading"><section class="interior"><div class="eyebrow">PLAY / READING</div><h1>Books I love.<br/>Ideas that stay.</h1><p class="lede">What I’m reading, what I keep thinking about, and the ideas I carry from one book into the next.</p><div class="reading-block book-grid"><div class="section-heading"><span class="accent-mark"></span><span>CURRENTLY READING</span></div>{books.filter(b=>b.status==='reading').length ? books.filter(b=>b.status==='reading').map(book=><a class="book-tile" href={`https://openlibrary.org/search?q=${encodeURIComponent(book.title+' '+book.author)}`} target="_blank" rel="noopener noreferrer"><span class="book-art"><span>{book.title}</span><small>{book.author}</small></span><strong>{book.title}</strong><small>{book.author} ↗</small></a>) : <p class="empty-state">This shelf is waiting for its first book.</p>}</div><div class="reading-block book-grid"><div class="section-heading"><span class="accent-mark"></span><span>BOOKS I RETURN TO</span></div>{books.filter(b=>b.status==='favorite').length ? books.filter(b=>b.status==='favorite').map(book=><a class="book-tile" href={`https://openlibrary.org/search?q=${encodeURIComponent(book.title+' '+book.author)}`} target="_blank" rel="noopener noreferrer"><span class="book-art"><span>{book.title}</span><small>{book.author}</small></span><strong>{book.title}</strong><small>{book.author} ↗</small></a>) : <p class="empty-state">Favorites and annotations coming soon.</p>}</div></section></Base>
