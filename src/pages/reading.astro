---
import Base from '../layouts/Base.astro';
import {books} from '../data/content.js';
---
<Base title="Reading"><section class="interior"><div class="eyebrow">PLAY / READING</div><h1>Books I love.<br/>Ideas that stay.</h1><p class="lede">What I’m reading, what I keep thinking about, and the ideas I carry from one book into the next.</p><div class="reading-block"><div class="section-heading"><span class="accent-mark"></span><span>CURRENTLY READING</span></div>{books.filter(b=>b.status==='reading').length ? books.filter(b=>b.status==='reading').map(book=><p><strong>{book.title}</strong> — {book.author}</p>) : <p class="empty-state">This shelf is waiting for its first book.</p>}</div><div class="reading-block"><div class="section-heading"><span class="accent-mark"></span><span>BOOKS I KEEP THINKING ABOUT</span></div>{books.filter(b=>b.status==='favorite').length ? books.filter(b=>b.status==='favorite').map(book=><p><strong>{book.title}</strong> — {book.author}<br/>{book.note}</p>) : <p class="empty-state">Favorites and annotations coming soon.</p>}</div></section></Base>
