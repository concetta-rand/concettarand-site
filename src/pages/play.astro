---
import Base from '../layouts/Base.astro';
import {projects, pull} from '../data/content.js';
---
<Base title="Play"><section class="interior"><div class="eyebrow">PLAY / EXPERIMENTS & RABBIT HOLES</div><h1>Things I’m<br/>tinkering with.</h1><p class="lede">Some useful. Some unnecessary. Some still looking for a reason to exist.</p><div class="project-grid project-grid-page">{projects.map(project=>project.href ? <a class="project-card" href={project.href} target="_blank" rel="noopener noreferrer"><div class={`project-art ${project.art}`}><span>{project.art==='cookies'?'✳  ◌  ✳': '↗  ↗'}</span></div><div class="project-info"><div class="index">{project.type}</div><h2>{project.title}</h2><p>{project.description}</p><span class="small-link">EXPLORE ↗</span></div></a> : <article class="project-card"><div class={`project-art ${project.art}`}><span>◎  ↗  ◎</span></div><div class="project-info"><div class="index">{project.type}</div><h2>{project.title}</h2><p>{project.description}</p><span class="small-link">STILL TINKERING</span></div></article>)}</div><a href="/reading/" class="reading-callout"><div><span class="eyebrow">ALSO IN PLAY</span><h2>Things I’m reading.</h2><p>What’s on my reading list, and the books I return to.</p></div><span class="callout-arrow">↗</span></a><section class="pull-section"><div class="eyebrow">A FEW RECURRING THEMES</div><h2>Things that pull at me.</h2><p class="pull-intro">Ideas, practices, and experiences I keep finding my way back to.</p><div class="pull-grid">{pull.map(item=><article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></section></section></Base>
