---
import Base from '../layouts/Base.astro';
import Network from '../components/Network.astro';
import {site} from '../data/site.js';
import {notes, projects} from '../data/content.js';
---
<Base><section class="hero"><div class="hero-copy"><div class="eyebrow">CONCETTA RAND</div><h1>I build things<br/>and connect things.</h1><p class="hero-sub">Builder, connector, and translator.</p><p class="hero-description">I work across organizations, ideas, people, and places—usually when something new is trying to emerge.</p><div class="hero-actions"><a class="button" href="/work/">Explore my work <span>→</span></a>{site.sections.play && <a class="text-link" href="/play/">See what I’m making →</a>}{site.sections.notes && <a class="text-link" href="/notes/">Read my notes →</a>}</div></div><Network /></section>
{site.sections.now && <section class="section now-section"><div class="section-heading"><span class="accent-mark"></span><span>NOW</span></div><div class="now-content"><h2>I’m thinking a lot about place, connection, and community—particularly as AI changes how, and where, we work.</h2><p>As AI makes building radically easier, place, relationships, and human connection become more valuable. I’m currently at Innovate Carolina and The Junction, where I get to see this play out in real time.</p></div></section>}
{site.sections.notes && <section class="section notes-section"><div class="section-intro"><div class="eyebrow">NOTES</div><h2>Ideas, observations<br/>and works in progress.</h2><a class="small-link" href="/notes/">SEE ALL NOTES →</a></div><div class="note-list">{notes.slice(0,3).map(note=><a class="note-row" href={`/notes/${note.slug}/`}><div><h3>{note.title}</h3><p>{note.excerpt}</p></div><time datetime={note.date}>{new Date(note.date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time></a>)}</div></section>}
{site.sections.play && <section class="section play-section"><div class="section-intro"><div class="eyebrow">PLAY</div><h2>Things I’m<br/>tinkering with.</h2><a class="small-link" href="/play/">SEE ALL PROJECTS →</a></div><div class="project-grid">{projects.slice(0,2).map(project=><a class="project-card" href={project.href} target="_blank" rel="noopener noreferrer"><div class={`project-art ${project.art}`}><span>{project.art==='margin'?'↗  ↗':'✳  ◌  ✳'}</span></div><div class="project-info"><h3>{project.title}</h3><p>{project.description}</p><span class="small-link">EXPLORE ↗</span></div></a>)}</div></section>}
{site.sections.work && <section class="section work-section"><div class="section-heading"><span class="accent-mark"></span><span>SELECTED WORK</span></div><div class="work-grid"><article><div class="work-number">01</div><div class="work-symbol">⌂</div><h3>Building</h3><p>Turning an idea, opportunity, or messy problem into something tangible.</p></article><article><div class="work-number">02</div><div class="work-symbol">◎</div><h3>Connecting</h3><p>Creating useful connections between people, organizations, ideas, and resources.</p></article><article><div class="work-number">03</div><div class="work-symbol">△</div><h3>Translating</h3><p>Turning strategy into execution—and translating between different teams and perspectives.</p></article></div><a class="small-link" href="/work/">MORE ABOUT MY WORK →</a></section>}
{(site.sections.about || site.sections.reading) && <section class="section beyond-section"><div class="section-heading"><span class="accent-mark"></span><span>BEYOND THE WORK</span></div><div class="beyond-grid">{site.sections.about && <div class="beyond-panel"><div class="eyebrow">A LITTLE ABOUT ME</div><h2>More than one thing.</h2><p>I’ve spent much of my career working between people, ideas, and organizations, especially when something is changing, growing, or trying to take shape.</p><a class="small-link" href="/about/">MORE ABOUT ME →</a></div>}{site.sections.reading && <div class="beyond-panel"><div class="eyebrow">IDEAS & READING</div><h2>Books I pick up again, and again.</h2><p>What I’m reading, what I keep returning to, and the connections I find along the way.</p><a class="small-link" href="/reading/">VISIT THE BOOKSHELF →</a></div>}</div></section>}
</Base>
