---
import { site } from '../data/site.js';
import '../styles/global.css';
const {title, description='A personal notebook about building, connecting, place, and the occasionally ridiculous things we can make with AI.'} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['Home','/'],
  ...(site.sections.notes ? [['Notes','/notes/']] : []),
  ...(site.sections.work ? [['Work','/work/']] : []),
  ...(site.sections.play ? [['Play','/play/']] : []),
  ...(site.sections.about ? [['About','/about/']] : [])
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title ? `${title} — ${site.name}` : site.name}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet"/></head><body><div class="site-shell"><header class="site-header"><a class="wordmark" href="/">CONCETTA RAND</a><nav aria-label="Main navigation">{nav.map(([label,url]) => <a href={url} aria-current={path===url?'page':undefined}>{label}</a>)}</nav></header><main><slot /></main><footer class="site-footer"><div><h2>Say hello.</h2><p>Ideas, projects, or just to connect.</p></div><div class="footer-links">{site.email && <a href={`mailto:${site.email}`}>Email ↗</a>}{site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}<a href="/about/">About ↗</a></div><div class="footer-location">CONCETTA RAND<br/>CHAPEL HILL, NC</div></footer></div></body></html>
